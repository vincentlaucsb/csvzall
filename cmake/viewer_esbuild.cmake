# Use a host tool even when the CLI is being cross-compiled.
function(csvzall_find_esbuild output)
  set(version 0.25.12)
  if(CSVZALL_ESBUILD_EXECUTABLE)
    execute_process(COMMAND "${CSVZALL_ESBUILD_EXECUTABLE}" --version OUTPUT_VARIABLE installed
      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT installed STREQUAL version)
      message(FATAL_ERROR "CSVZALL_ESBUILD_EXECUTABLE must be esbuild ${version}")
    endif()
    set(${output} "${CSVZALL_ESBUILD_EXECUTABLE}" PARENT_SCOPE)
    return()
  endif()

  string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" os)
  string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" arch)
  if(os STREQUAL "windows")
    set(os win32)
  endif()
  if(arch MATCHES "^(amd64|x86_64)$")
    set(arch x64)
  elseif(arch STREQUAL "aarch64")
    set(arch arm64)
  endif()
  set(host "${os}-${arch}")
  set(hash_win32-x64 6a5242d2e099a5316b48bd020838dc8257815cf9c2ac40214c120ba5e029eccfce160a2ab407ad7c1cd7d31334d0c52c5553e956394fb8c6d112a9d90976939c)
  set(hash_darwin-x64 1d0f646b82b1db5a875f0b654d455b2893809e61b58a95e17564e635788fccf7d62a95ea01255c59d9dfd9b9cbef7c208cdac55c06b7c98bc149df69cdf108a4)
  set(hash_linux-x64 baa64c4cbaffcd1fde7788c81a7c122e468798f8ce8c9be79ba4d5562b406b4f122d2f59d1533cc08471ee059b241e7f279e18b883089c3aae5b262f40b66483)
  set(hash_win32-arm64 acc98baeeafae00efe0ca9674aec2a51d44ac9ddd413ba0f2599a7963a84a6d7ac28cf30c7d27c831e6ed3ef4fab47d0416f2fa9e29e6f035775f3b23fef01b2)
  set(hash_darwin-arm64 377ce5fa5c470a27e022570c50fe74d7a11291e4232e3ffde7d471c4d608b61220f82407227ba316e5de59b58c8274e8e1ca795d51ea14f9a9caef49eb90b562)
  set(hash_linux-arm64 f1bc17edaf05821220aeea5cc5be1a5266032e9f295f4eab1a1e47a834fb6c1fbc45d7a596cea61efac51c75b624038f6546e78d4a4a4cb83a102cb3bdab3601)
  if(NOT DEFINED hash_${host})
    message(STATUS "Using unbundled native viewer on ${host}; set CSVZALL_ESBUILD_EXECUTABLE to enable bundling")
    return()
  endif()
  include(FetchContent)
  FetchContent_Declare(csvzall_esbuild
    URL "https://registry.npmjs.org/@esbuild/${host}/-/${host}-${version}.tgz"
    URL_HASH "SHA512=${hash_${host}}"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(csvzall_esbuild)
  if(os STREQUAL "win32")
    set(exe esbuild.exe)
  else()
    set(exe bin/esbuild)
  endif()
  set(${output} "${csvzall_esbuild_SOURCE_DIR}/${exe}" PARENT_SCOPE)
endfunction()
